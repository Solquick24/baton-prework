{
  "name": "baton-prework",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "baton-prework",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.12.0 <23",
        "npm": ">=10 <11"
      }
    },
    "apps/api": {
      "name": "@baton/api",
      "version": "0.0.0",
      "dependencies": {
        "@baton/contracts": "0.0.0"
      }
    },
    "apps/web": {
      "name": "@baton/web",
      "version": "0.0.0",
      "dependencies": {
        "@baton/contracts": "0.0.0"
      }
    },
    "node_modules/@baton/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@baton/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@baton/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/contracts": {
      "name": "@baton/contracts",
      "version": "0.0.0"
    }
  }
}
